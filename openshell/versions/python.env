# Python stack pins. Sourced by install-python.sh.
# uv is 0.x and tracks the newest stable release. CPython stays on 3.13.
# pre-commit stays on its pinned minor. uv verifies those two downloads,
# so this file does not pin a sha256 for them.

# https://github.com/astral-sh/uv/releases
UV_VERSION=0.13.5
UV_SHA256_AMD64=57ef9d9ccb01fb1bd998df995b0dd221b52f7d7841fbea93f2d4463bf61fb7a9
UV_SHA256_ARM64=7906c79adb21c81abd559841ba76bb1d9af9d791acac7a041b2972e03ae16538

# CPython build that `uv python install` can fetch.
PYTHON_VERSION=3.13.17

# https://pypi.org/project/pre-commit/
PRE_COMMIT_VERSION=4.7.0
