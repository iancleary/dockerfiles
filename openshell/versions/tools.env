# Pinned inputs for the agent-cli floor.
# Sourced by install-agent-cli.sh. Comments are ignored by the shell.
# amd64 and arm64 checksums are sha256 of the downloaded archive.
# The image build rejects a tarball whose checksum does not match.
# Release line is the pinned minor. bump-versions.sh updates the patch.

# https://github.com/sharkdp/fd/releases
FD_VERSION=10.5.0
FD_SHA256_AMD64=761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7
FD_SHA256_ARM64=d76c4317f7d5dba69f8a2a15856c90c777e7f0dd4e85f0de8c76de6992c374d4

# https://github.com/BurntSushi/ripgrep/releases
RG_VERSION=15.2.0
RG_SHA256_AMD64=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c
RG_SHA256_ARM64=800b1e7206afe799dfb5a6901f23147cfaabe0e52210538100f61e86e1740915

