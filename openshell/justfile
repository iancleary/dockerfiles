# Local OpenShell image builds. Docker must already be running.
# Images stay on this machine as openshell-<layer>:phase1.
# CI calls these same recipes with OPENSHELL_BASE_IMAGE set to the parent
# digest. Harness builds load the image and smoke-test it before the push
# step sets OPENSHELL_BUILD_FLAGS for a digest-only push. Other images
# push by digest from the build.

set shell := ["bash", "-euo", "pipefail", "-c"]

images := source_directory()
build_script := images / "scripts" / "docker-build.sh"
# justfile() is the root file that imported this module. That file has no
# image recipes. Child builds call agent-cli through this module file.
module_just := images / "justfile"

agent_cli_tag := env_var_or_default("OPENSHELL_AGENT_CLI_TAG", "openshell-agent-cli:phase1")
python_tag := env_var_or_default("OPENSHELL_PYTHON_TAG", "openshell-python:phase1")
rust_tag := env_var_or_default("OPENSHELL_RUST_TAG", "openshell-rust:phase1")
go_tag := env_var_or_default("OPENSHELL_GO_TAG", "openshell-go:phase1")
pi_tag := env_var_or_default("OPENSHELL_PI_TAG", "openshell-pi:phase1")
codex_tag := env_var_or_default("OPENSHELL_CODEX_TAG", "openshell-codex:phase1")
claude_tag := env_var_or_default("OPENSHELL_CLAUDE_TAG", "openshell-claude:phase1")

# List image recipes without building.
default:
    @just --justfile {{ quote(module_just) }} --list

# Build every default image.
build: all

# Stop when the Docker CLI is missing or the daemon is not already running.
[private]
_require-docker:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v docker >/dev/null 2>&1; then
      printf 'docker is not on PATH. Start Docker yourself, then re-run.\n' >&2
      exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
      printf 'Docker is not running. Start it yourself, then re-run.\n' >&2
      exit 1
    fi

# Build agent-cli, python, rust, and go through build.sh.
stacks: _require-docker
    @bash {{ quote(images / "build.sh") }}

# Build openshell-agent-cli:phase1.
agent-cli: _require-docker
    @bash {{ quote(build_script) }} {{ quote(images / "agent-cli" / "Dockerfile") }} {{ quote(images) }} {{ quote(agent_cli_tag) }} FD_VERSION RG_VERSION JUST_VERSION

# Build openshell-python:phase1 on agent-cli.
python: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "python" / "Dockerfile") }} {{ quote(images) }} {{ quote(python_tag) }} UV_VERSION PYTHON_VERSION PYTHON_STANDALONE_TAG

# Build openshell-rust:phase1 on agent-cli.
rust: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "rust" / "Dockerfile") }} {{ quote(images) }} {{ quote(rust_tag) }} RUST_VERSION

# Build openshell-go:phase1 on agent-cli.
go: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "go" / "Dockerfile") }} {{ quote(images) }} {{ quote(go_tag) }} GO_VERSION

# Build openshell-pi:phase1 on agent-cli.
pi: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "pi" / "Dockerfile") }} {{ quote(images) }} {{ quote(pi_tag) }} PI_VERSION

# Build openshell-codex:phase1 on agent-cli.
codex: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "codex" / "Dockerfile") }} {{ quote(images) }} {{ quote(codex_tag) }} CODEX_VERSION

# Build openshell-claude:phase1 on agent-cli.
claude: _require-docker
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${OPENSHELL_BASE_IMAGE:-}" ]]; then
      just --justfile {{ quote(module_just) }} agent-cli
    fi
    bash {{ quote(build_script) }} {{ quote(images / "claude" / "Dockerfile") }} {{ quote(images) }} {{ quote(claude_tag) }} CLAUDE_VERSION

# Build local-only openshell-pi:rust on the rust stack. Not a published package.
pi-rust: rust
    #!/usr/bin/env bash
    set -euo pipefail
    OPENSHELL_BASE_IMAGE=openshell-rust:phase1 \
      bash {{ quote(build_script) }} {{ quote(images / "pi" / "Dockerfile") }} {{ quote(images) }} openshell-pi:rust PI_VERSION

# Build every image, then smoke-test each one as its default user.
all: stacks pi codex claude smoke

# Confirm the floor runs as uid 1000 and the CLIs execute.
smoke-agent-cli: agent-cli
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} agent-cli {{ quote(agent_cli_tag) }}

# Confirm uv and CPython run as uid 1000.
smoke-python: python
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} python {{ quote(python_tag) }}

# Confirm rustc runs as uid 1000.
smoke-rust: rust
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} rust {{ quote(rust_tag) }}

# Confirm go runs as uid 1000.
smoke-go: go
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} go {{ quote(go_tag) }}

# Load a mounted TypeScript extension inside the Pi image.
smoke-pi: pi
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} pi {{ quote(pi_tag) }}

# Run codex --version in the image. No credentialed check.
smoke-codex: codex
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} codex {{ quote(codex_tag) }}

# Run claude --version in the image. No credentialed check.
smoke-claude: claude
    #!/usr/bin/env bash
    set -euo pipefail
    bash {{ quote(images / "scripts" / "smoke-image.sh") }} claude {{ quote(claude_tag) }}

# Smoke-test every image as its default user. No --user override.
smoke: smoke-agent-cli smoke-python smoke-rust smoke-go smoke-pi smoke-codex smoke-claude
