# Pinned inputs for the shared OpenShell images.
# Sourced by the install scripts. Comments are ignored by the shell.
# amd64 and arm64 checksums are sha256 of the downloaded archive.
# Renovate bumps *_VERSION. Update the sha256 lines in the same change.
# The image build rejects a tarball whose checksum does not match.

# https://github.com/sharkdp/fd/releases/tag/v10.5.0
FD_VERSION=10.5.0
FD_SHA256_AMD64=761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7
FD_SHA256_ARM64=d76c4317f7d5dba69f8a2a15856c90c777e7f0dd4e85f0de8c76de6992c374d4

# https://github.com/BurntSushi/ripgrep/releases/tag/15.2.0
