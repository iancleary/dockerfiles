# debian:bookworm-slim multi-arch index.
# The digest starts equal to openshell/versions/base.env.
# dev-images/scripts/update_pinned_versions.sh rewrites this digest when
# the bookworm-slim index changes. It does not select a different Debian release.
DEBIAN_VERSION=bookworm-slim
DEBIAN_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
DEBIAN_CHECKSUM_SOURCE=docker_hub_manifest_list_digest
