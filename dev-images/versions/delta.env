# delta 0.20.1 from dandavison/delta release 0.20.1.
# arm64 publishes no musl build. Both architectures use the gnu archive, which links
# against the Debian glibc in this image.
# The release publishes no checksum file. The recorded sha256 is the GitHub asset digest.
# The downloaded amd64 archive matches that digest.
DELTA_VERSION=0.20.1
DELTA_ARCHIVE_URL_AMD64=https://github.com/dandavison/delta/releases/download/0.20.1/delta-0.20.1-x86_64-unknown-linux-gnu.tar.gz
DELTA_ARCHIVE_URL_ARM64=https://github.com/dandavison/delta/releases/download/0.20.1/delta-0.20.1-aarch64-unknown-linux-gnu.tar.gz
DELTA_SHA256_AMD64=50f08c879f84c81ceb220e476491a7f492d2c9c671e79918cc44badf961a6240
DELTA_SHA256_ARM64=da7f4338f593572ff426ae153e0870e2fdc72729416eff551b40cdeb67940db8
DELTA_CHECKSUM_SOURCE=github_release_asset_digest
