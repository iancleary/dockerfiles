# ast-grep 0.51.0 from ast-grep/ast-grep release 0.51.0.
# The release publishes no checksum file. The recorded sha256 is the GitHub asset digest
# of the linux gnu zip archives. The downloaded amd64 archive matches that digest.
# The zip also contains a deprecated sg shim that does not run. The image installs ast-grep only.
AST_GREP_VERSION=0.51.0
AST_GREP_ARCHIVE_URL_AMD64=https://github.com/ast-grep/ast-grep/releases/download/0.51.0/app-x86_64-unknown-linux-gnu.zip
AST_GREP_ARCHIVE_URL_ARM64=https://github.com/ast-grep/ast-grep/releases/download/0.51.0/app-aarch64-unknown-linux-gnu.zip
AST_GREP_SHA256_AMD64=a7eead5552d3a8daad70f5d50d935da44bd0c138e946b5b0a96b1d38169fa639
AST_GREP_SHA256_ARM64=73af0ebe5958acee012754a5b2826a186580ef83333092408a7a01096fc30b8b
AST_GREP_CHECKSUM_SOURCE=github_release_asset_digest
