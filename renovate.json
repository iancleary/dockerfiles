{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "prBodyNotes": [
    "Image builds verify sha256 pins. If this PR changes a `*_VERSION` value or a harness `ARG`, update the matching checksum in `openshell/common/versions.env` or the harness `install-*.sh` in the same PR. The build fails until they match. Node stays on 24 and CPython stays on 3.13."
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian"],
      "allowedVersions": "bookworm-slim"
    },
    {
      "matchPackageNames": [
        "openshell-agent-cli",
        "openshell-python",
        "openshell-rust",
        "openshell-go",
        "openshell-pi",
        "openshell-codex",
        "openshell-claude"
      ],
      "enabled": false
    },
    {
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24\\./"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["python/cpython"],
      "allowedVersions": "/^3\\.13\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["FD_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "sharkdp/fd",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["RG_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "BurntSushi/ripgrep",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["JUST_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["UV_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["PYTHON_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "python/cpython",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["PRE_COMMIT_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pre-commit",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["RUST_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/common/versions\\.env$/"],
      "matchStrings": ["GO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golang/go",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^go(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/pi/Dockerfile$/"],
      "matchStrings": ["ARG PI_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/pi/Dockerfile$/"],
      "matchStrings": ["ARG NODE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/codex/Dockerfile$/"],
      "matchStrings": ["ARG CODEX_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "openai/codex",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^rust-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openshell/claude/Dockerfile$/"],
      "matchStrings": ["ARG CLAUDE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "anthropics/claude-code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
